# ==============================================================================
# Production-Grade RAG Chat Assistant Environment Configurations
# Copy this file to '.env' and fill in your private api keys.
# ==============================================================================

# Core Generative AI Stack Keys
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Async Connection Pool Settings
# By default, writes to a local 'rag_assistant.db' SQLite file in the backend
DATABASE_URL=sqlite+aiosqlite:///./rag_assistant.db

# JWT Session Authentication Security Keys
# Generate a secure 32-character string using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretkeychangeinproduction1234567890!@#
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Smart Chunking & Semantic Vector Store Custom Tunings
# target size/overlaps are quantified in LLM tokens
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Semantic Search Matching Controls
# cos similarity score threshold (strictly drops results below 0.75)
SIMILARITY_THRESHOLD=0.75
TOP_K=5

# System Performance Rates limits
# requests allowed per client IP per window (60s)
RATE_LIMIT_CHAT_MAX_REQUESTS=60
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
